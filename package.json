{
  "name": "@kurkle/color",
  "type": "module",
  "version": "0.0.0-development",
  "description": "css color parsing, manupulation and conversion",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/color.cjs",
  "module": "dist/color.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.ts",
        "default": "./dist/color.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/color.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.js && kurkle-build-cjs-types",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run && npm run test:chartjs && npm run test:pack",
    "test:coverage": "vitest run --coverage && npm run test:chartjs && npm run test:pack",
    "test:pack": "kurkle-check-package",
    "typecheck": "tsc --noEmit",
    "test:chartjs": "npm --prefix test/chartjs-compat ci --ignore-scripts && npm --prefix test/chartjs-compat run check",
    "docs": "typedoc && touch docs/.nojekyll && mv -f docs/tmp/* docs/ && rm -rd docs/tmp",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurkle/color.git"
  },
  "files": [
    "dist/*"
  ],
  "keywords": [
    "color",
    "colour",
    "css",
    "hsl",
    "hex",
    "rgb",
    "rgba",
    "hwb",
    "hsv",
    "cmyk",
    "oklch"
  ],
  "author": "Jukka Kurkela",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kurkle/color/issues"
  },
  "homepage": "https://github.com/kurkle/color#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@kurkle/configs": "^1.8.1",
    "@vitest/coverage-v8": "^5.0.0",
    "color-name": "^2.0.0",
    "esbuild": "^0.28.2",
    "esbuild-visualizer": "^0.7.0",
    "semantic-release": "^25.0.9",
    "typedoc": "^0.28.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
