{
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitThis": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES6"
  },
  "include": ["src/*.ts"],
  "exclude": ["node_modules", "dist", "test", "src/**/*.test.ts"]
}
